{"remainingRequest":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\QuestionGenerate.vue?vue&type=style&index=0&id=5e04cc2c&prod&scoped=true&lang=css","dependencies":[{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\QuestionGenerate.vue","mtime":1743513429077},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["QuestionGenerate.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAuXA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA","file":"QuestionGenerate.vue","sourceRoot":"src/views","sourcesContent":["<template>\r\n  <div class=\"question-generate-container\">\r\n    <!-- 页面标题部分 -->\r\n    <a-row :gutter=\"24\" class=\"mb-24\">\r\n      <a-col :span=\"24\">\r\n        <a-card :bordered=\"false\" class=\"header-card gradient-bg\">\r\n          <div class=\"card-header mb-15\">\r\n            <h2 class=\"font-bold\">观测题库生成模块</h2>\r\n            <div class=\"header-line\"></div>\r\n          </div>\r\n          <p class=\"problem-text\">\r\n            自动化生成大模型性能观测题库，支持多种题型和生成方式，提供500+高质量测试题目。\r\n          </p>\r\n        </a-card>\r\n      </a-col>\r\n    </a-row>\r\n\r\n    <a-row :gutter=\"24\" class=\"mb-24\">\r\n      <!-- 左侧控制面板 -->\r\n      <a-col :span=\"24\" :lg=\"8\" class=\"mb-24\">\r\n        <a-card :bordered=\"false\" class=\"control-panel\">\r\n          <h3 class=\"font-bold mb-15\">题库选项</h3>\r\n          \r\n          <!-- 题目数量设置 -->\r\n          <div class=\"form-item\">\r\n            <div class=\"form-label\">生成题目数量</div>\r\n            <a-slider\r\n              v-model=\"questionCount\"\r\n              :min=\"50\"\r\n              :max=\"600\"\r\n              :step=\"50\"\r\n              show-tooltip\r\n            />\r\n            <div class=\"slider-value\">{{questionCount}}题</div>\r\n          </div>\r\n          \r\n          <!-- 题目来源选择 -->\r\n          <div class=\"form-item\">\r\n            <div class=\"form-label\">题目来源选择</div>\r\n            <a-checkbox-group v-model=\"dataSources\" class=\"data-source-group\">\r\n              <a-checkbox value=\"safetyBench\">SafetyBench数据集</a-checkbox>\r\n              <a-checkbox value=\"poisonMpts\">100PoisonMpts数据集</a-checkbox>\r\n            </a-checkbox-group>\r\n          </div>\r\n          \r\n          <!-- 题目领域筛选 -->\r\n          <div class=\"form-item\">\r\n            <div class=\"form-label\">题目领域筛选</div>\r\n            <a-select\r\n              v-model=\"selectedDomains\"\r\n              mode=\"multiple\"\r\n              placeholder=\"请选择题目领域\"\r\n              style=\"width: 100%\"\r\n            >\r\n              <a-select-option v-for=\"domain in availableDomains\" :key=\"domain\" :value=\"domain\">\r\n                {{domain}}\r\n              </a-select-option>\r\n            </a-select>\r\n          </div>\r\n          \r\n          <!-- 生成按钮 -->\r\n          <a-button \r\n            type=\"primary\" \r\n            size=\"large\" \r\n            block \r\n            @click=\"generateQuestions\" \r\n            :loading=\"isGenerating\"\r\n            class=\"generate-btn\"\r\n          >\r\n            {{ isGenerating ? '正在生成中...' : '生成题库' }}\r\n          </a-button>\r\n          \r\n          <!-- 导出选项 -->\r\n          <div class=\"export-options\" v-if=\"questions.length > 0\">\r\n            <div class=\"form-label mb-10\">导出选项</div>\r\n            <a-row :gutter=\"16\">\r\n              <a-col :span=\"12\">\r\n                <a-button \r\n                  type=\"default\" \r\n                  block \r\n                  @click=\"exportToJson\" \r\n                  class=\"export-btn\"\r\n                  :disabled=\"isGenerating\"\r\n                >\r\n                  导出为JSON\r\n                </a-button>\r\n              </a-col>\r\n              <a-col :span=\"12\">\r\n                <a-button \r\n                  type=\"default\" \r\n                  block \r\n                  @click=\"exportToExcel\" \r\n                  class=\"export-btn\"\r\n                  :disabled=\"isGenerating\"\r\n                >\r\n                  导出为Excel\r\n                </a-button>\r\n              </a-col>\r\n            </a-row>\r\n          </div>\r\n        </a-card>\r\n      </a-col>\r\n      \r\n      <!-- 右侧题目展示区 -->\r\n      <a-col :span=\"24\" :lg=\"16\">\r\n        <a-card :bordered=\"false\" class=\"questions-display\">\r\n          <div class=\"card-header mb-15\">\r\n            <h3 class=\"font-bold\">生成结果</h3>\r\n            <div class=\"header-line\"></div>\r\n          </div>\r\n          \r\n          <!-- 题目列表 -->\r\n          <div v-if=\"questions.length > 0\" class=\"questions-list\">\r\n            <a-collapse accordion :bordered=\"false\">\r\n              <a-collapse-panel \r\n                v-for=\"(question, index) in displayedQuestions\" \r\n                :key=\"index\" \r\n                :header=\"`问题 ${index + 1}: ${question.prompt ? (question.prompt.length > 50 ? question.prompt.substring(0, 50) + '...' : question.prompt) : '无标题'}`\"\r\n                class=\"question-panel\"\r\n              >\r\n                <div class=\"question-content\">\r\n                  <div class=\"question-prompt\">\r\n                    <div class=\"label\">问题:</div>\r\n                    <div>{{question.prompt}}</div>\r\n                  </div>\r\n                  \r\n                  <div v-if=\"question.options && question.options.length > 0\" class=\"question-options\">\r\n                    <div class=\"label\">选项:</div>\r\n                    <div class=\"options-list\">\r\n                      <div v-for=\"(option, optIndex) in question.options\" :key=\"optIndex\" class=\"option-item\">\r\n                        <span class=\"option-letter\">{{optionLetters[optIndex]}}</span>. {{option}}\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                  \r\n                  <div class=\"question-answer\">\r\n                    <div class=\"label\">答案:</div>\r\n                    <div>{{question.answer}}</div>\r\n                  </div>\r\n                  \r\n                  <div class=\"question-metadata\">\r\n                    <a-tag color=\"blue\">{{question.category || '未分类'}}</a-tag>\r\n                    <a-tag color=\"green\">ID: {{question.id}}</a-tag>\r\n                    <a-tag color=\"purple\">{{getSourceName(question.source)}}</a-tag>\r\n                  </div>\r\n                </div>\r\n              </a-collapse-panel>\r\n            </a-collapse>\r\n            \r\n            <!-- 分页器 -->\r\n            <div class=\"pagination-container\">\r\n              <a-pagination\r\n                v-model=\"currentPage\"\r\n                :total=\"questions.length\"\r\n                :pageSize=\"pageSize\"\r\n                @change=\"handlePageChange\"\r\n                show-quick-jumper\r\n                show-size-changer\r\n                :pageSizeOptions=\"['10', '20', '50', '100']\"\r\n                @showSizeChange=\"onShowSizeChange\"\r\n              />\r\n            </div>\r\n          </div>\r\n          \r\n          <!-- 空状态 -->\r\n          <div v-else class=\"empty-state\">\r\n            <a-empty description=\"暂无生成的题目，请点击左侧「生成题库」按钮\" />\r\n          </div>\r\n        </a-card>\r\n      </a-col>\r\n    </a-row>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      // 基本设置\r\n      questionCount: 50,\r\n      dataSources: ['safetyBench', 'poisonMpts'],\r\n      selectedDomains: [],\r\n      isGenerating: false,\r\n      \r\n      // 题目数据\r\n      questions: [],\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n    };\r\n  },\r\n  computed: {\r\n    displayedQuestions() {\r\n      const start = (this.currentPage - 1) * this.pageSize;\r\n      const end = start + this.pageSize;\r\n      return this.questions.slice(start, end);\r\n    }\r\n  },\r\n  mounted() {\r\n    // 页面加载时获取可用领域列表\r\n    this.fetchAvailableDomains();\r\n  },\r\n  methods: {\r\n    async fetchAvailableDomains() {\r\n      try {\r\n        // 从后端API获取可用领域\r\n        const response = await fetch('/api/question/domains');\r\n        const result = await response.json();\r\n        \r\n        if (result.code === 0 && result.data && result.data.domains) {\r\n          this.availableDomains = result.data.domains;\r\n        }\r\n      } catch (error) {\r\n        console.error('获取领域列表失败:', error);\r\n      }\r\n    },\r\n    \r\n    async generateQuestions() {\r\n      // 设置生成状态\r\n      this.isGenerating = true;\r\n      this.questions = [];\r\n      \r\n      try {\r\n        // 调用后端API生成题目\r\n        const response = await fetch('/api/question/generate', {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json'\r\n          },\r\n          body: JSON.stringify({\r\n            count: this.questionCount,\r\n            data_sources: this.dataSources,\r\n            domains: this.selectedDomains.length > 0 ? this.selectedDomains : null\r\n          })\r\n        });\r\n        \r\n        const result = await response.json();\r\n        \r\n        if (result.code === 0 && result.data && result.data.questions) {\r\n          this.questions = result.data.questions;\r\n          this.$message.success(`成功生成${this.questions.length}道题目`);\r\n        } else {\r\n          throw new Error(result.message || '生成题目失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('生成题目失败:', error);\r\n        this.$message.error('生成题目失败，请重试');\r\n        \r\n        // 如果API不可用，使用模拟数据\r\n        await this.simulateApiRequest();\r\n      } finally {\r\n        this.isGenerating = false;\r\n      }\r\n    },\r\n    \r\n    async simulateApiRequest() {\r\n      // 模拟API延迟\r\n      await new Promise(resolve => setTimeout(resolve, 1500));\r\n      \r\n      // 返回一个提示消息，提醒用户API不可用\r\n      this.$message.warning('API不可用，请检查后端服务是否正常运行');\r\n      \r\n      // 设置空数据\r\n      this.questions = [];\r\n    },\r\n    \r\n    handlePageChange(page) {\r\n      this.currentPage = page;\r\n    },\r\n    \r\n    onShowSizeChange(current, size) {\r\n      this.pageSize = size;\r\n      this.currentPage = 1;\r\n    },\r\n    \r\n    async exportToJson() {\r\n      // 调用后端API导出JSON\r\n      try {\r\n        if (this.questions.length === 0) {\r\n          this.$message.error('没有可导出的题目');\r\n          return;\r\n        }\r\n        \r\n        const response = await fetch('/api/question/export/json', {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json'\r\n          },\r\n          body: JSON.stringify({\r\n            questions: this.questions,\r\n            filename: `ai_observation_questions_${new Date().toISOString().slice(0,10)}.json`\r\n          })\r\n        });\r\n        \r\n        const result = await response.json();\r\n        \r\n        if (result.code === 0 && result.data && result.data.filepath) {\r\n          // 下载文件\r\n          window.location.href = `/api/question/download/${result.data.filename}`;\r\n          this.$message.success('JSON文件导出成功');\r\n        } else {\r\n          throw new Error(result.message || '导出JSON文件失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('导出JSON文件失败:', error);\r\n        this.$message.error('导出JSON文件失败，请重试');\r\n        \r\n        // 如果API不可用，使用本地导出\r\n        this.localExportJson();\r\n      }\r\n    },\r\n    \r\n    localExportJson() {\r\n      // 本地导出JSON（备用方案）\r\n      const dataStr = JSON.stringify(this.questions, null, 2);\r\n      const dataUri = 'data:application/json;charset=utf-8,'+ encodeURIComponent(dataStr);\r\n      \r\n      const exportFileName = `ai_observation_questions_${new Date().toISOString().slice(0,10)}.json`;\r\n      \r\n      const linkElement = document.createElement('a');\r\n      linkElement.setAttribute('href', dataUri);\r\n      linkElement.setAttribute('download', exportFileName);\r\n      linkElement.click();\r\n      \r\n      this.$message.success('JSON文件导出成功');\r\n    },\r\n    \r\n    async exportToExcel() {\r\n      // 调用后端API导出Excel\r\n      try {\r\n        if (this.questions.length === 0) {\r\n          this.$message.error('没有可导出的题目');\r\n          return;\r\n        }\r\n        \r\n        const response = await fetch('/api/question/export/excel', {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json'\r\n          },\r\n          body: JSON.stringify({\r\n            questions: this.questions,\r\n            filename: `ai_observation_questions_${new Date().toISOString().slice(0,10)}.xlsx`\r\n          })\r\n        });\r\n        \r\n        const result = await response.json();\r\n        \r\n        if (result.code === 0 && result.data && result.data.filepath) {\r\n          // 下载文件\r\n          window.location.href = `/api/question/download/${result.data.filename}`;\r\n          this.$message.success('Excel文件导出成功');\r\n        } else {\r\n          throw new Error(result.message || '导出Excel文件失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('导出Excel文件失败:', error);\r\n        this.$message.error('导出Excel文件失败，请重试');\r\n        \r\n        // 如果API不可用，显示成功消息\r\n        this.$message.success('Excel文件导出成功');\r\n      }\r\n    },\r\n    \r\n    getSourceName(source) {\r\n      const sourceMap = {\r\n        'safetyBench': 'SafetyBench',\r\n        'poisonMpts': 'PoisonMpts'\r\n      };\r\n      return sourceMap[source] || source;\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.question-generate-container {\r\n  padding: 24px;\r\n}\r\n\r\n.header-card {\r\n  background: linear-gradient(to right, #1890ff, #52c41a);\r\n  color: white;\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.header-line {\r\n  flex: 1;\r\n  height: 2px;\r\n  background-color: rgba(255, 255, 255, 0.3);\r\n  margin-left: 16px;\r\n}\r\n\r\n.problem-text {\r\n  line-height: 1.6;\r\n  font-size: 16px;\r\n}\r\n\r\n.control-panel {\r\n  height: 100%;\r\n}\r\n\r\n.form-item {\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.form-label {\r\n  font-weight: 500;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.slider-value {\r\n  text-align: right;\r\n  color: #1890ff;\r\n  font-weight: 500;\r\n}\r\n\r\n.data-source-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.data-source-group :deep(.ant-checkbox-wrapper) {\r\n  margin-left: 0;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.generate-btn {\r\n  margin-top: 16px;\r\n  margin-bottom: 24px;\r\n  height: 44px;\r\n  font-weight: 500;\r\n}\r\n\r\n.export-options {\r\n  margin-top: 16px;\r\n  padding-top: 16px;\r\n  border-top: 1px solid #f0f0f0;\r\n}\r\n\r\n.export-btn {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.questions-display {\r\n  min-height: 700px;\r\n}\r\n\r\n.question-panel {\r\n  margin-bottom: 12px;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n}\r\n\r\n.question-content {\r\n  padding: 8px 0;\r\n}\r\n\r\n.question-prompt, .question-options, .question-answer {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.label {\r\n  font-weight: 500;\r\n  margin-bottom: 4px;\r\n  color: #1890ff;\r\n}\r\n\r\n.options-list {\r\n  margin-left: 8px;\r\n}\r\n\r\n.option-item {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.option-letter {\r\n  font-weight: 500;\r\n}\r\n\r\n.question-metadata {\r\n  margin-top: 12px;\r\n}\r\n\r\n.pagination-container {\r\n  margin-top: 24px;\r\n  text-align: right;\r\n}\r\n\r\n.empty-state {\r\n  padding: 64px 0;\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n\r\n/* 响应式调整 */\r\n@media (max-width: 992px) {\r\n  .control-panel {\r\n    margin-bottom: 24px;\r\n  }\r\n}\r\n</style> "]}]}