{"remainingRequest":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\QuestionGenerate.vue?vue&type=style&index=0&id=3635eb96&lang=scss&scoped=true","dependencies":[{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\QuestionGenerate.vue","mtime":1743152980893},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\sass-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["QuestionGenerate.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmrBA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA","file":"QuestionGenerate.vue","sourceRoot":"src/views","sourcesContent":["<template>\r\n  <div class=\"question-generate-container\">\r\n    <!-- 页头 -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"back-link\">\r\n          <router-link to=\"/cover\">\r\n            <a-icon type=\"arrow-left\" /> 返回首页\r\n          </router-link>\r\n        </div>\r\n        <h1 class=\"header-title\">观测题库生成与预览</h1>\r\n        <p class=\"header-desc\">根据您的需求自动生成大模型性能观测题库，并在同一页面查看生成结果</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 主内容区 -->\r\n    <div class=\"content-section\">\r\n      <div class=\"content-wrapper\">\r\n        <!-- 配置面板 -->\r\n        <a-card class=\"config-card\" :bordered=\"false\">\r\n          <div class=\"card-header mb-15\">\r\n            <h2 class=\"font-bold\">生成配置</h2>\r\n            <div class=\"header-line\"></div>\r\n          </div>\r\n\r\n          <a-form :form=\"form\" layout=\"vertical\">\r\n            <!-- 题目领域 -->\r\n            <a-form-item label=\"题目领域\">\r\n              <a-select\r\n                v-model=\"formData.domain\"\r\n                placeholder=\"请选择题目所属领域\"\r\n                style=\"width: 100%\"\r\n              >\r\n                <a-select-option value=\"general\">通用能力</a-select-option>\r\n                <a-select-option value=\"safety\">安全性评估</a-select-option>\r\n                <a-select-option value=\"reasoning\">逻辑推理能力</a-select-option>\r\n                <a-select-option value=\"knowledge\">知识准确性</a-select-option>\r\n                <a-select-option value=\"code\">代码能力</a-select-option>\r\n                <a-select-option value=\"math\">数学能力</a-select-option>\r\n                <a-select-option value=\"chinese\">中文理解</a-select-option>\r\n                <a-select-option value=\"multimodal\">多模态能力</a-select-option>\r\n              </a-select>\r\n            </a-form-item>\r\n\r\n            <!-- 难度级别 -->\r\n            <a-form-item label=\"难度级别\">\r\n              <a-slider\r\n                v-model=\"formData.difficulty\"\r\n                :marks=\"{\r\n                  1: '初级',\r\n                  2: '中级',\r\n                  3: '高级',\r\n                  4: '专家',\r\n                  5: '挑战'\r\n                }\"\r\n                :min=\"1\"\r\n                :max=\"5\"\r\n                :step=\"1\"\r\n              />\r\n            </a-form-item>\r\n\r\n            <!-- 题目类型 -->\r\n            <a-form-item label=\"题目类型\">\r\n              <a-checkbox-group v-model=\"formData.questionTypes\">\r\n                <a-row :gutter=\"[16, 16]\">\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"multiple_choice\">选择题</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"true_false\">判断题</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"short_answer\">简答题</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"fill_blank\">填空题</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"code_completion\">代码补全</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"scenario\">情景分析</a-checkbox>\r\n                  </a-col>\r\n                </a-row>\r\n              </a-checkbox-group>\r\n            </a-form-item>\r\n\r\n            <!-- 内容来源 -->\r\n            <a-form-item label=\"内容来源\">\r\n              <a-checkbox-group v-model=\"formData.contentSources\">\r\n                <a-row :gutter=\"[16, 16]\">\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"database\">题库数据</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"crawler\">网络爬虫</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"ai_generate\">AI生成</a-checkbox>\r\n                  </a-col>\r\n                </a-row>\r\n              </a-checkbox-group>\r\n            </a-form-item>\r\n\r\n            <!-- 自定义关键词 -->\r\n            <a-form-item label=\"自定义关键词（可选）\">\r\n              <a-input-group compact>\r\n                <a-input\r\n                  v-model=\"keywordInput\"\r\n                  style=\"width: calc(100% - 78px)\"\r\n                  placeholder=\"输入关键词并按回车添加\"\r\n                  @pressEnter=\"addKeyword\"\r\n                />\r\n                <a-button @click=\"addKeyword\" type=\"primary\">添加</a-button>\r\n              </a-input-group>\r\n              <div class=\"keyword-tags mt-10\" v-if=\"formData.keywords.length > 0\">\r\n                <a-tag \r\n                  v-for=\"(keyword, index) in formData.keywords\"\r\n                  :key=\"index\"\r\n                  closable\r\n                  @close=\"removeKeyword(index)\"\r\n                  color=\"blue\"\r\n                >\r\n                  {{ keyword }}\r\n                </a-tag>\r\n              </div>\r\n            </a-form-item>\r\n\r\n            <!-- 生成数量 -->\r\n            <a-form-item label=\"生成数量\">\r\n              <a-input-number\r\n                v-model=\"formData.count\"\r\n                :min=\"10\"\r\n                :max=\"1000\"\r\n                :step=\"10\"\r\n                style=\"width: 160px\"\r\n              />\r\n              <span class=\"ml-10\">题（推荐值: 500）</span>\r\n            </a-form-item>\r\n\r\n            <!-- 高级选项 -->\r\n            <a-collapse class=\"custom-collapse\">\r\n              <a-collapse-panel key=\"1\" header=\"高级选项\">\r\n                <!-- AI提供者选择 -->\r\n                <a-form-item label=\"AI模型提供商\">\r\n                  <a-radio-group v-model=\"formData.aiProvider\" button-style=\"solid\">\r\n                    <a-radio-button value=\"openai\">OpenAI</a-radio-button>\r\n                    <a-radio-button value=\"azure\">Azure OpenAI</a-radio-button>\r\n                    <a-radio-button value=\"anthropic\">Anthropic</a-radio-button>\r\n                    <a-radio-button value=\"baidu\">文心一言</a-radio-button>\r\n                    <a-radio-button value=\"xfyun\">讯飞星火</a-radio-button>\r\n                  </a-radio-group>\r\n                </a-form-item>\r\n\r\n                <!-- 爬取来源 -->\r\n                <a-form-item label=\"网络爬取来源\" v-if=\"formData.contentSources.includes('crawler')\">\r\n                  <a-select\r\n                    v-model=\"formData.crawlerSources\"\r\n                    mode=\"multiple\"\r\n                    placeholder=\"请选择网络爬取来源\"\r\n                    style=\"width: 100%\"\r\n                  >\r\n                    <a-select-option value=\"wikipedia\">维基百科</a-select-option>\r\n                    <a-select-option value=\"github\">GitHub</a-select-option>\r\n                    <a-select-option value=\"stackoverflow\">Stack Overflow</a-select-option>\r\n                    <a-select-option value=\"zhihu\">知乎</a-select-option>\r\n                    <a-select-option value=\"csdn\">CSDN</a-select-option>\r\n                    <a-select-option value=\"academic\">学术论文</a-select-option>\r\n                  </a-select>\r\n                </a-form-item>\r\n              </a-collapse-panel>\r\n            </a-collapse>\r\n\r\n            <!-- 操作按钮 -->\r\n            <div class=\"action-buttons mt-24\">\r\n              <a-button @click=\"resetForm\">重置</a-button>\r\n              <a-button type=\"primary\" @click=\"generateQuestions\" :loading=\"loading\" class=\"ml-10\">\r\n                生成题库\r\n              </a-button>\r\n            </div>\r\n          </a-form>\r\n        </a-card>\r\n\r\n        <!-- 生成结果和题库预览合并区域 -->\r\n        <a-card class=\"result-card mt-24\" :bordered=\"false\" v-if=\"questionResult.total > 0\">\r\n          <div class=\"card-header mb-15\">\r\n            <h2 class=\"font-bold\">题库结果与预览</h2>\r\n            <div class=\"header-line\"></div>\r\n          </div>\r\n\r\n          <!-- 统计和分析区域 -->\r\n          <a-tabs default-active-key=\"1\">\r\n            <a-tab-pane key=\"1\" tab=\"统计分析\">\r\n              <div class=\"result-stats\">\r\n                <a-row :gutter=\"24\">\r\n                  <a-col :span=\"8\">\r\n                    <a-statistic title=\"已生成题目数量\" :value=\"questionResult.total\" />\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-statistic title=\"题目类型数量\" :value=\"questionResult.typeCount\" />\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-statistic title=\"生成用时\" :value=\"questionResult.timeUsed\" suffix=\"秒\" :precision=\"2\" />\r\n                  </a-col>\r\n                </a-row>\r\n              </div>\r\n\r\n              <div class=\"charts-container mt-24\">\r\n                <a-row :gutter=\"24\">\r\n                  <a-col :span=\"8\">\r\n                    <div class=\"chart-container type-distribution\">\r\n                      <h3>题型分布</h3>\r\n                      <div class=\"chart-placeholder\">\r\n                        <p>饼图 - 显示各类题型的比例</p>\r\n                      </div>\r\n                    </div>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <div class=\"chart-container difficulty-distribution\">\r\n                      <h3>难度分布</h3>\r\n                      <div class=\"chart-placeholder\">\r\n                        <p>条形图 - 显示各难度级别的题目数量</p>\r\n                      </div>\r\n                    </div>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <div class=\"chart-container source-distribution\">\r\n                      <h3>来源分布</h3>\r\n                      <div class=\"chart-placeholder\">\r\n                        <p>饼图 - 显示各来源的题目比例</p>\r\n                      </div>\r\n                    </div>\r\n                  </a-col>\r\n                </a-row>\r\n              </div>\r\n            </a-tab-pane>\r\n\r\n            <a-tab-pane key=\"2\" tab=\"题目列表\">\r\n              <!-- 筛选器 -->\r\n              <a-form layout=\"inline\" class=\"filter-form mb-15\">\r\n                <a-form-item label=\"题目类型\">\r\n                  <a-select v-model=\"filters.type\" placeholder=\"选择题目类型\" allowClear style=\"width: 140px\">\r\n                    <a-select-option value=\"multiple_choice\">选择题</a-select-option>\r\n                    <a-select-option value=\"true_false\">判断题</a-select-option>\r\n                    <a-select-option value=\"short_answer\">简答题</a-select-option>\r\n                    <a-select-option value=\"fill_blank\">填空题</a-select-option>\r\n                    <a-select-option value=\"code_completion\">代码补全</a-select-option>\r\n                    <a-select-option value=\"scenario\">情景分析</a-select-option>\r\n                  </a-select>\r\n                </a-form-item>\r\n                <a-form-item label=\"难度级别\">\r\n                  <a-select v-model=\"filters.difficulty\" placeholder=\"选择难度级别\" allowClear style=\"width: 120px\">\r\n                    <a-select-option value=\"1\">初级</a-select-option>\r\n                    <a-select-option value=\"2\">中级</a-select-option>\r\n                    <a-select-option value=\"3\">高级</a-select-option>\r\n                    <a-select-option value=\"4\">专家</a-select-option>\r\n                    <a-select-option value=\"5\">挑战</a-select-option>\r\n                  </a-select>\r\n                </a-form-item>\r\n                <a-form-item label=\"关键词\">\r\n                  <a-input v-model=\"filters.keyword\" placeholder=\"搜索关键词\" allowClear style=\"width: 150px\" />\r\n                </a-form-item>\r\n                <a-form-item>\r\n                  <a-button type=\"primary\" @click=\"applyFilters\">应用筛选</a-button>\r\n                  <a-button @click=\"resetFilters\" class=\"ml-10\">重置</a-button>\r\n                </a-form-item>\r\n              </a-form>\r\n\r\n              <!-- 题目表格 -->\r\n              <a-table \r\n                :columns=\"columns\" \r\n                :dataSource=\"filteredQuestions\" \r\n                :pagination=\"pagination\"\r\n                :loading=\"tableLoading\"\r\n                @change=\"handleTableChange\"\r\n                rowKey=\"id\"\r\n              >\r\n                <span slot=\"type\" slot-scope=\"text\">\r\n                  {{ typeMap[text] || '未知类型' }}\r\n                </span>\r\n                \r\n                <span slot=\"difficulty\" slot-scope=\"text\">\r\n                  <a-tag :color=\"getDifficultyColor(text)\">\r\n                    {{ getDifficultyLabel(text) }}\r\n                  </a-tag>\r\n                </span>\r\n                \r\n                <span slot=\"content\" slot-scope=\"text\">\r\n                  {{ text.length > 50 ? text.substring(0, 50) + '...' : text }}\r\n                </span>\r\n                \r\n                <span slot=\"action\" slot-scope=\"text, record\">\r\n                  <a @click=\"viewQuestion(record)\">查看</a>\r\n                </span>\r\n              </a-table>\r\n            </a-tab-pane>\r\n\r\n            <a-tab-pane key=\"3\" tab=\"随机预览\">\r\n              <div class=\"result-preview\">\r\n                <h3>题目预览（随机10题）</h3>\r\n                <a-collapse class=\"custom-collapse mt-15\">\r\n                  <a-collapse-panel \r\n                    v-for=\"(question, index) in questionResult.previewQuestions\" \r\n                    :key=\"index\"\r\n                    :header=\"getQuestionHeader(question, index)\"\r\n                  >\r\n                    <div class=\"question-content\">\r\n                      <div v-if=\"question.type === 'multiple_choice'\">\r\n                        <p>{{ question.content }}</p>\r\n                        <a-radio-group class=\"option-list\">\r\n                          <div v-for=\"(option, optIndex) in question.options\" :key=\"optIndex\">\r\n                            <a-radio :value=\"option.key\">{{ option.key }}. {{ option.content }}</a-radio>\r\n                          </div>\r\n                        </a-radio-group>\r\n                        <div class=\"answer mt-10\">\r\n                          <strong>正确答案：</strong> {{ question.answer }}\r\n                        </div>\r\n                      </div>\r\n                      <div v-else-if=\"question.type === 'true_false'\">\r\n                        <p>{{ question.content }}</p>\r\n                        <div class=\"answer mt-10\">\r\n                          <strong>正确答案：</strong> {{ question.answer ? '正确' : '错误' }}\r\n                        </div>\r\n                      </div>\r\n                      <div v-else>\r\n                        <p>{{ question.content }}</p>\r\n                        <div class=\"answer mt-10\" v-if=\"question.answer\">\r\n                          <strong>参考答案：</strong> {{ question.answer }}\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </a-collapse-panel>\r\n                </a-collapse>\r\n              </div>\r\n            </a-tab-pane>\r\n          </a-tabs>\r\n\r\n          <div class=\"result-actions mt-24\">\r\n            <a-button-group>\r\n              <a-button type=\"primary\" @click=\"downloadQuestions\">\r\n                <a-icon type=\"download\" />下载题库\r\n              </a-button>\r\n              <a-button type=\"dashed\" @click=\"regenerate\">\r\n                <a-icon type=\"reload\" />重新生成\r\n              </a-button>\r\n            </a-button-group>\r\n          </div>\r\n        </a-card>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 题目详情弹窗 -->\r\n    <a-modal\r\n      :visible=\"questionModalVisible\"\r\n      :title=\"currentQuestion.title || '题目详情'\"\r\n      @cancel=\"questionModalVisible = false\"\r\n      :footer=\"null\"\r\n      width=\"700px\"\r\n    >\r\n      <div class=\"question-detail\">\r\n        <div class=\"question-header\">\r\n          <a-tag :color=\"getDifficultyColor(currentQuestion.difficulty)\">\r\n            {{ getDifficultyLabel(currentQuestion.difficulty) }}\r\n          </a-tag>\r\n          <a-tag>{{ typeMap[currentQuestion.type] || '未知类型' }}</a-tag>\r\n          <a-tag color=\"blue\">{{ sourceMap[currentQuestion.source] || '未知来源' }}</a-tag>\r\n        </div>\r\n        \r\n        <div class=\"question-body mt-15\">\r\n          <div v-if=\"currentQuestion.type === 'multiple_choice'\">\r\n            <p class=\"question-content\">{{ currentQuestion.content }}</p>\r\n            <div class=\"question-options mt-15\">\r\n              <div v-for=\"(option, index) in currentQuestion.options\" :key=\"index\" \r\n                :class=\"['option-item', option.key === currentQuestion.answer ? 'option-correct' : '']\">\r\n                <span class=\"option-key\">{{ option.key }}.</span>\r\n                <span class=\"option-text\">{{ option.content }}</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"question-answer mt-15\">\r\n              <p><strong>正确答案：</strong>{{ currentQuestion.answer }}</p>\r\n            </div>\r\n          </div>\r\n          \r\n          <div v-else-if=\"currentQuestion.type === 'true_false'\">\r\n            <p class=\"question-content\">{{ currentQuestion.content }}</p>\r\n            <div class=\"question-answer mt-15\">\r\n              <p><strong>正确答案：</strong>{{ currentQuestion.answer ? '正确' : '错误' }}</p>\r\n            </div>\r\n          </div>\r\n          \r\n          <div v-else>\r\n            <p class=\"question-content\">{{ currentQuestion.content }}</p>\r\n            <div class=\"question-answer mt-15\" v-if=\"currentQuestion.answer\">\r\n              <p><strong>参考答案：</strong></p>\r\n              <div class=\"answer-content\">{{ currentQuestion.answer }}</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <a-divider />\r\n        \r\n        <div class=\"question-meta\">\r\n          <p v-if=\"currentQuestion.keywords && currentQuestion.keywords.length\">\r\n            <strong>关键词：</strong>\r\n            <a-tag v-for=\"(keyword, index) in currentQuestion.keywords\" :key=\"index\" color=\"blue\">\r\n              {{ keyword }}\r\n            </a-tag>\r\n          </p>\r\n          <p v-if=\"currentQuestion.source_url\">\r\n            <strong>来源链接：</strong>\r\n            <a :href=\"currentQuestion.source_url\" target=\"_blank\">{{ currentQuestion.source_url }}</a>\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </a-modal>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      form: this.$form.createForm(this),\r\n      loading: false,\r\n      tableLoading: false,\r\n      keywordInput: '',\r\n      formData: {\r\n        domain: 'general',\r\n        difficulty: 3,\r\n        questionTypes: ['multiple_choice', 'true_false', 'short_answer'],\r\n        contentSources: ['database', 'ai_generate'],\r\n        keywords: [],\r\n        count: 500,\r\n        aiProvider: 'openai',\r\n        crawlerSources: ['wikipedia', 'stackoverflow']\r\n      },\r\n      filters: {\r\n        type: undefined,\r\n        difficulty: undefined,\r\n        keyword: '',\r\n        source: undefined\r\n      },\r\n      typeMap: {\r\n        'multiple_choice': '选择题',\r\n        'true_false': '判断题',\r\n        'short_answer': '简答题',\r\n        'fill_blank': '填空题',\r\n        'code_completion': '代码补全',\r\n        'scenario': '情景分析'\r\n      },\r\n      sourceMap: {\r\n        'database': '题库数据',\r\n        'crawler': '网络爬虫',\r\n        'ai_generate': 'AI生成'\r\n      },\r\n      columns: [\r\n        {\r\n          title: '序号',\r\n          dataIndex: 'id',\r\n          key: 'id',\r\n          width: 80\r\n        },\r\n        {\r\n          title: '题型',\r\n          dataIndex: 'type',\r\n          key: 'type',\r\n          width: 100,\r\n          scopedSlots: { customRender: 'type' }\r\n        },\r\n        {\r\n          title: '难度',\r\n          dataIndex: 'difficulty',\r\n          key: 'difficulty',\r\n          width: 100,\r\n          scopedSlots: { customRender: 'difficulty' }\r\n        },\r\n        {\r\n          title: '内容',\r\n          dataIndex: 'content',\r\n          key: 'content',\r\n          scopedSlots: { customRender: 'content' }\r\n        },\r\n        {\r\n          title: '来源',\r\n          dataIndex: 'source',\r\n          key: 'source',\r\n          width: 100,\r\n          render: (text) => this.sourceMap[text] || '未知'\r\n        },\r\n        {\r\n          title: '操作',\r\n          key: 'action',\r\n          width: 120,\r\n          scopedSlots: { customRender: 'action' }\r\n        }\r\n      ],\r\n      questionResult: {\r\n        total: 0,\r\n        typeCount: 0,\r\n        timeUsed: 0,\r\n        previewQuestions: [],\r\n        allQuestions: []\r\n      },\r\n      pagination: {\r\n        current: 1,\r\n        pageSize: 10,\r\n        total: 0\r\n      },\r\n      questionModalVisible: false,\r\n      currentQuestion: {}\r\n    }\r\n  },\r\n  computed: {\r\n    filteredQuestions() {\r\n      if (!this.questionResult.allQuestions || this.questionResult.allQuestions.length === 0) {\r\n        return [];\r\n      }\r\n      \r\n      let result = [...this.questionResult.allQuestions];\r\n      \r\n      // 应用过滤条件\r\n      if (this.filters.type) {\r\n        result = result.filter(q => q.type === this.filters.type);\r\n      }\r\n      \r\n      if (this.filters.difficulty) {\r\n        result = result.filter(q => q.difficulty === this.filters.difficulty);\r\n      }\r\n      \r\n      if (this.filters.keyword) {\r\n        const keyword = this.filters.keyword.toLowerCase();\r\n        result = result.filter(q => \r\n          q.content.toLowerCase().includes(keyword) || \r\n          (q.title && q.title.toLowerCase().includes(keyword)) ||\r\n          (q.keywords && q.keywords.some(k => k.toLowerCase().includes(keyword)))\r\n        );\r\n      }\r\n      \r\n      if (this.filters.source) {\r\n        result = result.filter(q => q.source === this.filters.source);\r\n      }\r\n      \r\n      return result;\r\n    }\r\n  },\r\n  methods: {\r\n    // 添加关键词\r\n    addKeyword() {\r\n      if (this.keywordInput && this.keywordInput.trim() !== '') {\r\n        if (!this.formData.keywords.includes(this.keywordInput)) {\r\n          this.formData.keywords.push(this.keywordInput.trim());\r\n        }\r\n        this.keywordInput = '';\r\n      }\r\n    },\r\n    \r\n    // 移除关键词\r\n    removeKeyword(index) {\r\n      this.formData.keywords.splice(index, 1);\r\n    },\r\n    \r\n    // 重置表单\r\n    resetForm() {\r\n      this.formData = {\r\n        domain: 'general',\r\n        difficulty: 3,\r\n        questionTypes: ['multiple_choice', 'true_false', 'short_answer'],\r\n        contentSources: ['database', 'ai_generate'],\r\n        keywords: [],\r\n        count: 500,\r\n        aiProvider: 'openai',\r\n        crawlerSources: ['wikipedia', 'stackoverflow']\r\n      };\r\n    },\r\n    \r\n    // 重置筛选条件\r\n    resetFilters() {\r\n      this.filters = {\r\n        type: undefined,\r\n        difficulty: undefined,\r\n        keyword: '',\r\n        source: undefined\r\n      };\r\n    },\r\n    \r\n    // 应用筛选条件\r\n    applyFilters() {\r\n      this.pagination.current = 1;\r\n    },\r\n    \r\n    // 生成题库\r\n    generateQuestions() {\r\n      if (this.formData.questionTypes.length === 0) {\r\n        this.$message.error('请至少选择一种题目类型');\r\n        return;\r\n      }\r\n      \r\n      if (this.formData.contentSources.length === 0) {\r\n        this.$message.error('请至少选择一种内容来源');\r\n        return;\r\n      }\r\n      \r\n      this.loading = true;\r\n      \r\n      // 记录开始时间\r\n      const startTime = new Date().getTime();\r\n      \r\n      // 调用后端API生成题库\r\n      this.$axios.post('/api/questions/generate', this.formData)\r\n        .then(response => {\r\n          // 计算用时（秒）\r\n          const timeUsed = (new Date().getTime() - startTime) / 1000;\r\n          \r\n          // 处理返回结果\r\n          const result = response.data;\r\n          this.questionResult = {\r\n            total: result.total,\r\n            typeCount: Object.keys(result.typeDistribution).length,\r\n            timeUsed: timeUsed,\r\n            previewQuestions: result.questions.slice(0, 10),\r\n            allQuestions: result.questions\r\n          };\r\n          \r\n          this.pagination.total = result.total;\r\n          \r\n          // 成功提示\r\n          this.$message.success(`成功生成${result.total}道题目`);\r\n        })\r\n        .catch(error => {\r\n          console.error('生成题库失败', error);\r\n          this.$message.error('生成题库失败：' + (error.response?.data?.message || '未知错误'));\r\n        })\r\n        .finally(() => {\r\n          this.loading = false;\r\n        });\r\n    },\r\n    \r\n    // 处理表格分页、排序、筛选变化\r\n    handleTableChange(pagination) {\r\n      this.pagination.current = pagination.current;\r\n    },\r\n    \r\n    // 获取难度标签\r\n    getDifficultyLabel(difficulty) {\r\n      const difficultyMap = {\r\n        1: '初级',\r\n        2: '中级',\r\n        3: '高级',\r\n        4: '专家',\r\n        5: '挑战'\r\n      };\r\n      return difficultyMap[difficulty] || '未知';\r\n    },\r\n    \r\n    // 获取难度对应的颜色\r\n    getDifficultyColor(difficulty) {\r\n      const colorMap = {\r\n        1: 'green',\r\n        2: 'cyan',\r\n        3: 'blue',\r\n        4: 'purple',\r\n        5: 'red'\r\n      };\r\n      return colorMap[difficulty] || 'default';\r\n    },\r\n    \r\n    // 获取问题标题\r\n    getQuestionHeader(question, index) {\r\n      return `${index + 1}. [${this.typeMap[question.type] || '未知类型'}] ${question.title || question.content.substring(0, 30)}...`;\r\n    },\r\n    \r\n    // 查看题目详情\r\n    viewQuestion(record) {\r\n      this.currentQuestion = { ...record };\r\n      this.questionModalVisible = true;\r\n    },\r\n    \r\n    // 下载题库\r\n    downloadQuestions() {\r\n      window.open('/api/questions/download', '_blank');\r\n    },\r\n    \r\n    // 重新生成\r\n    regenerate() {\r\n      this.generateQuestions();\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.question-generate-container {\r\n  min-height: 100vh;\r\n  background: #f5f5f5;\r\n}\r\n\r\n.page-header {\r\n  background: linear-gradient(135deg, rgba(69, 39, 160, 0.8), rgba(33, 150, 243, 0.8));\r\n  padding: 3rem 2rem;\r\n  color: #fff;\r\n  \r\n  .header-content {\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n  }\r\n  \r\n  .back-link {\r\n    margin-bottom: 1rem;\r\n    \r\n    a {\r\n      color: #fff;\r\n      display: inline-flex;\r\n      align-items: center;\r\n      font-size: 1rem;\r\n      \r\n      &:hover {\r\n        text-decoration: underline;\r\n      }\r\n      \r\n      .anticon {\r\n        margin-right: 0.5rem;\r\n      }\r\n    }\r\n  }\r\n  \r\n  .header-title {\r\n    font-size: 2rem;\r\n    font-weight: 600;\r\n    margin-bottom: 1rem;\r\n  }\r\n  \r\n  .header-desc {\r\n    font-size: 1.1rem;\r\n    opacity: 0.9;\r\n    max-width: 700px;\r\n  }\r\n}\r\n\r\n.content-section {\r\n  padding: 2rem;\r\n  \r\n  .content-wrapper {\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n  }\r\n}\r\n\r\n.config-card, .result-card {\r\n  background: #fff;\r\n  border-radius: 8px;\r\n  padding: 1.5rem;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  border-bottom: 1px solid #f0f0f0;\r\n  padding-bottom: 1rem;\r\n  \r\n  h2 {\r\n    margin: 0;\r\n    font-size: 1.25rem;\r\n  }\r\n  \r\n  .header-line {\r\n    height: 2px;\r\n    background: linear-gradient(to right, #4527a0, #2196f3);\r\n    width: 60px;\r\n  }\r\n}\r\n\r\n.action-buttons {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.keyword-tags {\r\n  margin-top: 8px;\r\n  \r\n  .ant-tag {\r\n    margin-bottom: 8px;\r\n  }\r\n}\r\n\r\n.custom-collapse {\r\n  background: transparent;\r\n  border: none;\r\n  \r\n  /deep/ .ant-collapse-header {\r\n    background: #f9f9f9;\r\n    border-radius: 4px !important;\r\n  }\r\n  \r\n  /deep/ .ant-collapse-content {\r\n    border-top: none;\r\n  }\r\n}\r\n\r\n.result-stats {\r\n  background: #f9f9f9;\r\n  padding: 1.5rem;\r\n  border-radius: 8px;\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.filter-form {\r\n  background: #f9f9f9;\r\n  padding: 1rem;\r\n  border-radius: 8px;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.charts-container {\r\n  margin-top: 2rem;\r\n}\r\n\r\n.chart-container {\r\n  background: #f9f9f9;\r\n  border-radius: 8px;\r\n  padding: 1rem;\r\n  height: 300px;\r\n  \r\n  h3 {\r\n    margin-top: 0;\r\n    margin-bottom: 1rem;\r\n    font-size: 1rem;\r\n  }\r\n  \r\n  .chart-placeholder {\r\n    height: 240px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    border: 1px dashed #ccc;\r\n    border-radius: 4px;\r\n    color: #999;\r\n  }\r\n}\r\n\r\n.question-content {\r\n  padding: 0.5rem;\r\n  \r\n  .option-list {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 0.5rem;\r\n    margin-top: 1rem;\r\n  }\r\n  \r\n  .answer {\r\n    margin-top: 1rem;\r\n    padding: 0.5rem;\r\n    background: #f5f5f5;\r\n    border-left: 3px solid #2196f3;\r\n  }\r\n}\r\n\r\n.question-detail {\r\n  .question-header {\r\n    margin-bottom: 1rem;\r\n  }\r\n  \r\n  .question-content {\r\n    font-size: 1.1rem;\r\n    line-height: 1.6;\r\n  }\r\n  \r\n  .question-options {\r\n    .option-item {\r\n      padding: 0.5rem;\r\n      margin-bottom: 0.5rem;\r\n      border-radius: 4px;\r\n      display: flex;\r\n      \r\n      &.option-correct {\r\n        background-color: rgba(82, 196, 26, 0.1);\r\n        border-left: 3px solid #52c41a;\r\n      }\r\n      \r\n      .option-key {\r\n        font-weight: bold;\r\n        margin-right: 0.5rem;\r\n        min-width: 20px;\r\n      }\r\n    }\r\n  }\r\n  \r\n  .question-answer {\r\n    background: #f5f5f5;\r\n    padding: 1rem;\r\n    border-radius: 4px;\r\n    \r\n    .answer-content {\r\n      white-space: pre-wrap;\r\n      line-height: 1.6;\r\n    }\r\n  }\r\n}\r\n\r\n.mt-10 {\r\n  margin-top: 10px;\r\n}\r\n\r\n.mt-15 {\r\n  margin-top: 15px;\r\n}\r\n\r\n.mt-24 {\r\n  margin-top: 24px;\r\n}\r\n\r\n.mb-15 {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.mb-24 {\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.ml-10 {\r\n  margin-left: 10px;\r\n}\r\n</style> "]}]}