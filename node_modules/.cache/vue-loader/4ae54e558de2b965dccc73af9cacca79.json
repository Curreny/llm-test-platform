{"remainingRequest":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\Cover.vue?vue&type=style&index=0&id=6d133326&scoped=true&lang=css","dependencies":[{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\Cover.vue","mtime":1742993715664},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Cover.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4IA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA","file":"Cover.vue","sourceRoot":"src/views","sourcesContent":["<template>\r\n  <div class=\"cover-page\">\r\n    <div class=\"cover-content\">\r\n      <!-- 平台标题和介绍 -->\r\n      <a-row :gutter=\"24\" class=\"mb-24\">\r\n        <a-col :span=\"24\">\r\n          <a-card :bordered=\"false\" class=\"header-card\">\r\n            <div class=\"text-center\">\r\n              <h1 class=\"text-4xl font-bold mb-4\">大模型性能与安全观测平台</h1>\r\n              <p class=\"text-lg text-gray-500\">多维度、全流程的安全性和能力观测方法</p>\r\n            </div>\r\n          </a-card>\r\n        </a-col>\r\n      </a-row>\r\n\r\n      <!-- 问题说明卡片 -->\r\n      <a-row :gutter=\"24\" class=\"mb-24\">\r\n        <a-col :span=\"24\">\r\n          <a-card :bordered=\"false\" class=\"problem-card gradient-bg\">\r\n            <h2 class=\"font-bold text-xl mb-4\">问题说明</h2>\r\n            <p class=\"text-base leading-relaxed\">\r\n              随着大模型技术的发展，性能漂移、数据泄露、结果不可控、数据偏见、AI幻觉等问题日益凸显，引发了全球范围内对AI安全的关注。为了应对这些挑战，国内外政策、法规迎来了新的探索与实践，安全行业也在积极探讨如何确保大模型性能与合规性。大模型能力与安全观测需要多维度、全流程的安全性和能力观测方法。\r\n            </p>\r\n          </a-card>\r\n        </a-col>\r\n      </a-row>\r\n\r\n      <!-- 用户期望部分 - 六个卡片 -->\r\n      <h2 class=\"font-bold text-xl mb-4\">用户期望</h2>\r\n      <a-row :gutter=\"24\" type=\"flex\" align=\"stretch\">\r\n        <!-- 观测题库生成模块 -->\r\n        <a-col :span=\"24\" :md=\"12\" :xl=\"8\" class=\"mb-24\">\r\n          <a-card :bordered=\"false\" class=\"feature-card h-full\">\r\n            <div class=\"feature-icon mb-4\">\r\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M9 5H7C5.89543 5 5 5.89543 5 7V19C5 20.1046 5.89543 21 7 21H17C18.1046 21 19 20.1046 19 19V7C19 5.89543 18.1046 5 17 5H15M9 5C9 6.10457 9.89543 7 11 7H13C14.1046 7 15 6.10457 15 5M9 5C9 3.89543 9.89543 3 11 3H13C14.1046 3 15 3.89543 15 5\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                <path d=\"M9 12H15\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                <path d=\"M9 16H15\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n              </svg>\r\n            </div>\r\n            <h3 class=\"font-bold mb-2\">观测题库生成模块</h3>\r\n            <p>能够根据用户输入，自动化生成大模型性能观测题库，题目形式不限于选择、简答与判断等，题目内容来源不限于爬虫、模型生成等，观测题库生成形式不限，测试题库不低于500题。</p>\r\n          </a-card>\r\n        </a-col>\r\n\r\n        <!-- 观测题库拓展模块 -->\r\n        <a-col :span=\"24\" :md=\"12\" :xl=\"8\" class=\"mb-24\">\r\n          <a-card :bordered=\"false\" class=\"feature-card h-full\">\r\n            <div class=\"feature-icon mb-4\">\r\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M8 3V5M16 3V5M7 21H17C19.2091 21 21 19.2091 21 17V9C21 6.79086 19.2091 5 17 5H7C4.79086 5 3 6.79086 3 9V17C3 19.2091 4.79086 21 7 21Z\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                <path d=\"M8 9H16M8 13H14M8 17H12\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n              </svg>\r\n            </div>\r\n            <h3 class=\"font-bold mb-2\">观测题库拓展模块</h3>\r\n            <p>能够自动化拓展测试题库，根据生成的测试题库，能够对测试题库进行\"变形\"，变形方式不低于5种，需展示变形过程，展现形式不限，变形后的题目有效性不低于90%。</p>\r\n          </a-card>\r\n        </a-col>\r\n\r\n        <!-- 数据审核模块 -->\r\n        <a-col :span=\"24\" :md=\"12\" :xl=\"8\" class=\"mb-24\">\r\n          <a-card :bordered=\"false\" class=\"feature-card h-full\">\r\n            <div class=\"feature-icon mb-4\">\r\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n              </svg>\r\n            </div>\r\n            <h3 class=\"font-bold mb-2\">数据审核模块</h3>\r\n            <p>针对大模型测试结果，平台能够自动审核测试结果，并将大模型输入、输出与判定结果进行页面展示，需支持多种审核模式，且自动化判定审核成功率大于90%。</p>\r\n          </a-card>\r\n        </a-col>\r\n\r\n        <!-- 结果生成模块 -->\r\n        <a-col :span=\"24\" :md=\"12\" :xl=\"8\" class=\"mb-24\">\r\n          <a-card :bordered=\"false\" class=\"feature-card h-full\">\r\n            <div class=\"feature-icon mb-4\">\r\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M9 19V13C9 11.8954 8.10457 11 7 11H5C3.89543 11 3 11.8954 3 13V19C3 20.1046 3.89543 21 5 21H7C8.10457 21 9 20.1046 9 19Z\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                <path d=\"M15 19V7C15 5.89543 14.1046 5 13 5H11C9.89543 5 9 5.89543 9 7V13\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n                <path d=\"M21 19V3C21 2.44772 20.5523 2 20 2H18C16.8954 2 16 2.89543 16 4V7\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n              </svg>\r\n            </div>\r\n            <h3 class=\"font-bold mb-2\">结果生成模块</h3>\r\n            <p>平台根据数据审核能力，自动化生成测试总体结果，结果包括模型的性能、安全性、推理速度、精度、内存和计算资源的消耗情况等，结果展现形式不唯一，多样化的呈现方式。</p>\r\n          </a-card>\r\n        </a-col>\r\n\r\n        <!-- 自动化报告生成 -->\r\n        <a-col :span=\"24\" :md=\"12\" :xl=\"8\" class=\"mb-24\">\r\n          <a-card :bordered=\"false\" class=\"feature-card h-full\">\r\n            <div class=\"feature-icon mb-4\">\r\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M9 17H5C3.89543 17 3 16.1046 3 15V5C3 3.89543 3.89543 3 5 3H19C20.1046 3 21 3.89543 21 5V15C21 16.1046 20.1046 17 19 17H15M9 17L12 21M9 17L12 13M15 17L12 21M15 17L12 13\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n              </svg>\r\n            </div>\r\n            <h3 class=\"font-bold mb-2\">自动化报告生成</h3>\r\n            <p>支持自动生成性能与安全性观测报告，供用户下载和审阅。</p>\r\n          </a-card>\r\n        </a-col>\r\n\r\n        <!-- 观测调用形式 -->\r\n        <a-col :span=\"24\" :md=\"12\" :xl=\"8\" class=\"mb-24\">\r\n          <a-card :bordered=\"false\" class=\"feature-card h-full\">\r\n            <div class=\"feature-icon mb-4\">\r\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M10 20L14 4M18 8L22 12L18 16M6 16L2 12L6 8\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n              </svg>\r\n            </div>\r\n            <h3 class=\"font-bold mb-2\">观测调用形式</h3>\r\n            <p>支持多样化平台调用形式，包括但不限于SDK、Saas等。</p>\r\n          </a-card>\r\n        </a-col>\r\n      </a-row>\r\n\r\n      <!-- 开始体验按钮 -->\r\n      <a-row :gutter=\"24\" class=\"mb-24\">\r\n        <a-col :span=\"24\" class=\"text-center\">\r\n          <a-button type=\"primary\" size=\"large\" @click=\"navigateToDashboard\">\r\n            开始体验\r\n          </a-button>\r\n        </a-col>\r\n      </a-row>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {};\r\n  },\r\n  methods: {\r\n    navigateToDashboard() {\r\n      this.$router.push('/dashboard');\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.cover-page {\r\n  min-height: 100vh;\r\n  background: url('/images/bg-profile.jpg') no-repeat center center;\r\n  background-size: cover;\r\n  position: relative;\r\n}\r\n\r\n.cover-page::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  background: rgba(255, 255, 255, 0.9);\r\n  z-index: 1;\r\n}\r\n\r\n.cover-content {\r\n  position: relative;\r\n  z-index: 2;\r\n  padding: 2rem;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.header-card {\r\n  margin-bottom: 2rem;\r\n  text-align: center;\r\n  background: linear-gradient(to right, rgba(243, 244, 246, 0.9), rgba(255, 255, 255, 0.9));\r\n  border-radius: 8px;\r\n  padding: 3rem 0;\r\n  backdrop-filter: blur(8px);\r\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.problem-card {\r\n  border-radius: 8px;\r\n  padding: 1.5rem;\r\n  margin-bottom: 2rem;\r\n  background-color: rgba(248, 250, 252, 0.9);\r\n  backdrop-filter: blur(8px);\r\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\r\n}\r\n\r\n.gradient-bg {\r\n  background: linear-gradient(135deg, rgba(243, 244, 246, 0.9), rgba(229, 231, 235, 0.9));\r\n}\r\n\r\n.feature-card {\r\n  border-radius: 8px;\r\n  transition: all 0.3s ease;\r\n  height: 100%;\r\n  backdrop-filter: blur(8px);\r\n  background-color: rgba(255, 255, 255, 0.9);\r\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\r\n  padding: 1.5rem;\r\n}\r\n\r\n.feature-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\r\n}\r\n\r\n.feature-icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 64px;\r\n  height: 64px;\r\n  border-radius: 12px;\r\n  background-color: rgba(243, 244, 246, 0.8);\r\n  color: #4b5563;\r\n}\r\n\r\nh1, h2, h3 {\r\n  color: #111827;\r\n}\r\n\r\n.mb-24 {\r\n  margin-bottom: 24px;\r\n}\r\n\r\nh1 {\r\n  font-size: 2.5rem;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\nh2 {\r\n  font-size: 1.75rem;\r\n  margin-bottom: 1.5rem;\r\n  color: #1f2937;\r\n}\r\n\r\nh3 {\r\n  font-size: 1.25rem;\r\n  margin-bottom: 0.75rem;\r\n}\r\n\r\np {\r\n  line-height: 1.6;\r\n}\r\n</style> "]}]}