{"remainingRequest":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\QuestionBank.vue?vue&type=script&lang=js","dependencies":[{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\QuestionBank.vue","mtime":1743152175943},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\babel-loader\\lib\\index.js","mtime":456789000000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["QuestionBank.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAuQA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA","file":"QuestionBank.vue","sourceRoot":"src/views","sourcesContent":["<template>\r\n  <div class=\"question-bank-container\">\r\n    <!-- 页头 -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"back-link\">\r\n          <router-link to=\"/cover\">\r\n            <a-icon type=\"arrow-left\" /> 返回首页\r\n          </router-link>\r\n        </div>\r\n        <h1 class=\"header-title\">观测题库生成模块</h1>\r\n        <p class=\"header-desc\">根据您的需求自动生成大模型性能观测题库，支持多种题型和内容来源</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 主内容区 -->\r\n    <div class=\"content-section\">\r\n      <div class=\"content-wrapper\">\r\n        <!-- 配置面板 -->\r\n        <a-card class=\"config-card\" :bordered=\"false\">\r\n          <div class=\"card-header mb-15\">\r\n            <h2 class=\"font-bold\">生成配置</h2>\r\n            <div class=\"header-line\"></div>\r\n          </div>\r\n\r\n          <a-form :form=\"form\" layout=\"vertical\">\r\n            <!-- 题目领域 -->\r\n            <a-form-item label=\"题目领域\">\r\n              <a-select\r\n                v-model=\"formData.domain\"\r\n                placeholder=\"请选择题目所属领域\"\r\n                style=\"width: 100%\"\r\n              >\r\n                <a-select-option value=\"general\">通用能力</a-select-option>\r\n                <a-select-option value=\"safety\">安全性评估</a-select-option>\r\n                <a-select-option value=\"reasoning\">逻辑推理能力</a-select-option>\r\n                <a-select-option value=\"knowledge\">知识准确性</a-select-option>\r\n                <a-select-option value=\"code\">代码能力</a-select-option>\r\n                <a-select-option value=\"math\">数学能力</a-select-option>\r\n                <a-select-option value=\"chinese\">中文理解</a-select-option>\r\n                <a-select-option value=\"multimodal\">多模态能力</a-select-option>\r\n              </a-select>\r\n            </a-form-item>\r\n\r\n            <!-- 难度级别 -->\r\n            <a-form-item label=\"难度级别\">\r\n              <a-slider\r\n                v-model=\"formData.difficulty\"\r\n                :marks=\"{\r\n                  1: '初级',\r\n                  2: '中级',\r\n                  3: '高级',\r\n                  4: '专家',\r\n                  5: '挑战'\r\n                }\"\r\n                :min=\"1\"\r\n                :max=\"5\"\r\n                :step=\"1\"\r\n              />\r\n            </a-form-item>\r\n\r\n            <!-- 题目类型 -->\r\n            <a-form-item label=\"题目类型\">\r\n              <a-checkbox-group v-model=\"formData.questionTypes\">\r\n                <a-row :gutter=\"[16, 16]\">\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"multiple_choice\">选择题</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"true_false\">判断题</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"short_answer\">简答题</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"fill_blank\">填空题</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"code_completion\">代码补全</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"scenario\">情景分析</a-checkbox>\r\n                  </a-col>\r\n                </a-row>\r\n              </a-checkbox-group>\r\n            </a-form-item>\r\n\r\n            <!-- 内容来源 -->\r\n            <a-form-item label=\"内容来源\">\r\n              <a-checkbox-group v-model=\"formData.contentSources\">\r\n                <a-row :gutter=\"[16, 16]\">\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"database\">题库数据</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"crawler\">网络爬虫</a-checkbox>\r\n                  </a-col>\r\n                  <a-col :span=\"8\">\r\n                    <a-checkbox value=\"ai_generate\">AI生成</a-checkbox>\r\n                  </a-col>\r\n                </a-row>\r\n              </a-checkbox-group>\r\n            </a-form-item>\r\n\r\n            <!-- 自定义关键词 -->\r\n            <a-form-item label=\"自定义关键词（可选）\">\r\n              <a-input-group compact>\r\n                <a-input\r\n                  v-model=\"keywordInput\"\r\n                  style=\"width: calc(100% - 78px)\"\r\n                  placeholder=\"输入关键词并按回车添加\"\r\n                  @pressEnter=\"addKeyword\"\r\n                />\r\n                <a-button @click=\"addKeyword\" type=\"primary\">添加</a-button>\r\n              </a-input-group>\r\n              <div class=\"keyword-tags mt-10\" v-if=\"formData.keywords.length > 0\">\r\n                <a-tag \r\n                  v-for=\"(keyword, index) in formData.keywords\"\r\n                  :key=\"index\"\r\n                  closable\r\n                  @close=\"removeKeyword(index)\"\r\n                  color=\"blue\"\r\n                >\r\n                  {{ keyword }}\r\n                </a-tag>\r\n              </div>\r\n            </a-form-item>\r\n\r\n            <!-- 生成数量 -->\r\n            <a-form-item label=\"生成数量\">\r\n              <a-input-number\r\n                v-model=\"formData.count\"\r\n                :min=\"10\"\r\n                :max=\"1000\"\r\n                :step=\"10\"\r\n                style=\"width: 160px\"\r\n              />\r\n              <span class=\"ml-10\">题（推荐值: 500）</span>\r\n            </a-form-item>\r\n\r\n            <!-- 高级选项 -->\r\n            <a-collapse class=\"custom-collapse\">\r\n              <a-collapse-panel key=\"1\" header=\"高级选项\">\r\n                <!-- AI提供者选择 -->\r\n                <a-form-item label=\"AI模型提供商\">\r\n                  <a-radio-group v-model=\"formData.aiProvider\" button-style=\"solid\">\r\n                    <a-radio-button value=\"openai\">OpenAI</a-radio-button>\r\n                    <a-radio-button value=\"azure\">Azure OpenAI</a-radio-button>\r\n                    <a-radio-button value=\"anthropic\">Anthropic</a-radio-button>\r\n                    <a-radio-button value=\"baidu\">文心一言</a-radio-button>\r\n                    <a-radio-button value=\"xfyun\">讯飞星火</a-radio-button>\r\n                  </a-radio-group>\r\n                </a-form-item>\r\n\r\n                <!-- 爬取来源 -->\r\n                <a-form-item label=\"网络爬取来源\" v-if=\"formData.contentSources.includes('crawler')\">\r\n                  <a-select\r\n                    v-model=\"formData.crawlerSources\"\r\n                    mode=\"multiple\"\r\n                    placeholder=\"请选择网络爬取来源\"\r\n                    style=\"width: 100%\"\r\n                  >\r\n                    <a-select-option value=\"wikipedia\">维基百科</a-select-option>\r\n                    <a-select-option value=\"github\">GitHub</a-select-option>\r\n                    <a-select-option value=\"stackoverflow\">Stack Overflow</a-select-option>\r\n                    <a-select-option value=\"zhihu\">知乎</a-select-option>\r\n                    <a-select-option value=\"csdn\">CSDN</a-select-option>\r\n                    <a-select-option value=\"academic\">学术论文</a-select-option>\r\n                  </a-select>\r\n                </a-form-item>\r\n              </a-collapse-panel>\r\n            </a-collapse>\r\n\r\n            <!-- 操作按钮 -->\r\n            <div class=\"action-buttons mt-24\">\r\n              <a-button @click=\"resetForm\">重置</a-button>\r\n              <a-button type=\"primary\" @click=\"generateQuestions\" :loading=\"loading\" class=\"ml-10\">\r\n                生成题库\r\n              </a-button>\r\n            </div>\r\n          </a-form>\r\n        </a-card>\r\n\r\n        <!-- 生成结果展示 -->\r\n        <a-card class=\"result-card mt-24\" :bordered=\"false\" v-if=\"questionResult.total > 0\">\r\n          <div class=\"card-header mb-15\">\r\n            <h2 class=\"font-bold\">生成结果</h2>\r\n            <div class=\"header-line\"></div>\r\n          </div>\r\n\r\n          <div class=\"result-stats\">\r\n            <a-row :gutter=\"24\">\r\n              <a-col :span=\"8\">\r\n                <a-statistic title=\"已生成题目数量\" :value=\"questionResult.total\" />\r\n              </a-col>\r\n              <a-col :span=\"8\">\r\n                <a-statistic title=\"题目类型数量\" :value=\"questionResult.typeCount\" />\r\n              </a-col>\r\n              <a-col :span=\"8\">\r\n                <a-statistic title=\"生成用时\" :value=\"questionResult.timeUsed\" suffix=\"秒\" :precision=\"2\" />\r\n              </a-col>\r\n            </a-row>\r\n          </div>\r\n\r\n          <a-divider />\r\n\r\n          <div class=\"result-preview\">\r\n            <h3>题目预览（随机10题）</h3>\r\n            <a-collapse class=\"custom-collapse mt-15\">\r\n              <a-collapse-panel \r\n                v-for=\"(question, index) in questionResult.previewQuestions\" \r\n                :key=\"index\"\r\n                :header=\"getQuestionHeader(question, index)\"\r\n              >\r\n                <div class=\"question-content\">\r\n                  <div v-if=\"question.type === 'multiple_choice'\">\r\n                    <p>{{ question.content }}</p>\r\n                    <a-radio-group class=\"option-list\">\r\n                      <div v-for=\"(option, optIndex) in question.options\" :key=\"optIndex\">\r\n                        <a-radio :value=\"option.key\">{{ option.key }}. {{ option.content }}</a-radio>\r\n                      </div>\r\n                    </a-radio-group>\r\n                    <div class=\"answer mt-10\">\r\n                      <strong>正确答案：</strong> {{ question.answer }}\r\n                    </div>\r\n                  </div>\r\n                  <div v-else-if=\"question.type === 'true_false'\">\r\n                    <p>{{ question.content }}</p>\r\n                    <div class=\"answer mt-10\">\r\n                      <strong>正确答案：</strong> {{ question.answer ? '正确' : '错误' }}\r\n                    </div>\r\n                  </div>\r\n                  <div v-else>\r\n                    <p>{{ question.content }}</p>\r\n                    <div class=\"answer mt-10\" v-if=\"question.answer\">\r\n                      <strong>参考答案：</strong> {{ question.answer }}\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </a-collapse-panel>\r\n            </a-collapse>\r\n          </div>\r\n\r\n          <div class=\"result-actions mt-24\">\r\n            <a-button-group>\r\n              <a-button type=\"primary\" @click=\"downloadQuestions\">\r\n                <a-icon type=\"download\" />下载题库\r\n              </a-button>\r\n              <a-button @click=\"previewMore\">\r\n                查看更多题目\r\n              </a-button>\r\n              <a-button type=\"dashed\" @click=\"regenerate\">\r\n                <a-icon type=\"reload\" />重新生成\r\n              </a-button>\r\n            </a-button-group>\r\n          </div>\r\n        </a-card>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      form: this.$form.createForm(this),\r\n      loading: false,\r\n      keywordInput: '',\r\n      formData: {\r\n        domain: 'general',\r\n        difficulty: 3,\r\n        questionTypes: ['multiple_choice', 'true_false', 'short_answer'],\r\n        contentSources: ['database', 'ai_generate'],\r\n        keywords: [],\r\n        count: 500,\r\n        aiProvider: 'openai',\r\n        crawlerSources: ['wikipedia', 'stackoverflow']\r\n      },\r\n      questionResult: {\r\n        total: 0,\r\n        typeCount: 0,\r\n        timeUsed: 0,\r\n        previewQuestions: []\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    // 添加关键词\r\n    addKeyword() {\r\n      if (this.keywordInput && this.keywordInput.trim() !== '') {\r\n        if (!this.formData.keywords.includes(this.keywordInput)) {\r\n          this.formData.keywords.push(this.keywordInput.trim());\r\n        }\r\n        this.keywordInput = '';\r\n      }\r\n    },\r\n    \r\n    // 移除关键词\r\n    removeKeyword(index) {\r\n      this.formData.keywords.splice(index, 1);\r\n    },\r\n    \r\n    // 重置表单\r\n    resetForm() {\r\n      this.formData = {\r\n        domain: 'general',\r\n        difficulty: 3,\r\n        questionTypes: ['multiple_choice', 'true_false', 'short_answer'],\r\n        contentSources: ['database', 'ai_generate'],\r\n        keywords: [],\r\n        count: 500,\r\n        aiProvider: 'openai',\r\n        crawlerSources: ['wikipedia', 'stackoverflow']\r\n      };\r\n    },\r\n    \r\n    // 生成题库\r\n    generateQuestions() {\r\n      if (this.formData.questionTypes.length === 0) {\r\n        this.$message.error('请至少选择一种题目类型');\r\n        return;\r\n      }\r\n      \r\n      if (this.formData.contentSources.length === 0) {\r\n        this.$message.error('请至少选择一种内容来源');\r\n        return;\r\n      }\r\n      \r\n      this.loading = true;\r\n      \r\n      // 记录开始时间\r\n      const startTime = new Date().getTime();\r\n      \r\n      // 调用后端API生成题库\r\n      this.$axios.post('/api/questions/generate', this.formData)\r\n        .then(response => {\r\n          // 计算用时（秒）\r\n          const timeUsed = (new Date().getTime() - startTime) / 1000;\r\n          \r\n          // 处理返回结果\r\n          const result = response.data;\r\n          this.questionResult = {\r\n            total: result.total,\r\n            typeCount: Object.keys(result.typeDistribution).length,\r\n            timeUsed: timeUsed,\r\n            previewQuestions: result.questions.slice(0, 10)\r\n          };\r\n          \r\n          // 成功提示\r\n          this.$message.success(`成功生成${result.total}道题目`);\r\n        })\r\n        .catch(error => {\r\n          console.error('生成题库失败', error);\r\n          this.$message.error('生成题库失败：' + (error.response?.data?.message || '未知错误'));\r\n        })\r\n        .finally(() => {\r\n          this.loading = false;\r\n        });\r\n    },\r\n    \r\n    // 获取问题标题\r\n    getQuestionHeader(question, index) {\r\n      const typeMap = {\r\n        'multiple_choice': '选择题',\r\n        'true_false': '判断题',\r\n        'short_answer': '简答题',\r\n        'fill_blank': '填空题',\r\n        'code_completion': '代码补全',\r\n        'scenario': '情景分析'\r\n      };\r\n      return `${index + 1}. [${typeMap[question.type] || '未知类型'}] ${question.title || question.content.substring(0, 30)}...`;\r\n    },\r\n    \r\n    // 下载题库\r\n    downloadQuestions() {\r\n      window.open('/api/questions/download', '_blank');\r\n    },\r\n    \r\n    // 查看更多题目\r\n    previewMore() {\r\n      this.$router.push('/question-preview');\r\n    },\r\n    \r\n    // 重新生成\r\n    regenerate() {\r\n      this.generateQuestions();\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.question-bank-container {\r\n  min-height: 100vh;\r\n  background: #f5f5f5;\r\n}\r\n\r\n.page-header {\r\n  background: linear-gradient(135deg, rgba(69, 39, 160, 0.8), rgba(33, 150, 243, 0.8));\r\n  padding: 3rem 2rem;\r\n  color: #fff;\r\n  \r\n  .header-content {\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n  }\r\n  \r\n  .header-title {\r\n    font-size: 2rem;\r\n    font-weight: 600;\r\n    margin-bottom: 1rem;\r\n  }\r\n  \r\n  .header-desc {\r\n    font-size: 1.1rem;\r\n    opacity: 0.9;\r\n    max-width: 700px;\r\n  }\r\n}\r\n\r\n.content-section {\r\n  padding: 2rem;\r\n  \r\n  .content-wrapper {\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n  }\r\n}\r\n\r\n.config-card, .result-card {\r\n  background: #fff;\r\n  border-radius: 8px;\r\n  padding: 1.5rem;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  border-bottom: 1px solid #f0f0f0;\r\n  padding-bottom: 1rem;\r\n  \r\n  h2 {\r\n    margin: 0;\r\n    font-size: 1.25rem;\r\n  }\r\n  \r\n  .header-line {\r\n    height: 2px;\r\n    background: linear-gradient(to right, #4527a0, #2196f3);\r\n    width: 60px;\r\n  }\r\n}\r\n\r\n.action-buttons {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.keyword-tags {\r\n  margin-top: 8px;\r\n  \r\n  .ant-tag {\r\n    margin-bottom: 8px;\r\n  }\r\n}\r\n\r\n.custom-collapse {\r\n  background: transparent;\r\n  border: none;\r\n  \r\n  /deep/ .ant-collapse-header {\r\n    background: #f9f9f9;\r\n    border-radius: 4px !important;\r\n  }\r\n  \r\n  /deep/ .ant-collapse-content {\r\n    border-top: none;\r\n  }\r\n}\r\n\r\n.result-stats {\r\n  background: #f9f9f9;\r\n  padding: 1.5rem;\r\n  border-radius: 8px;\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.question-content {\r\n  padding: 0.5rem;\r\n  \r\n  .option-list {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 0.5rem;\r\n    margin-top: 1rem;\r\n  }\r\n  \r\n  .answer {\r\n    margin-top: 1rem;\r\n    padding: 0.5rem;\r\n    background: #f5f5f5;\r\n    border-left: 3px solid #2196f3;\r\n  }\r\n}\r\n\r\n.mt-10 {\r\n  margin-top: 10px;\r\n}\r\n\r\n.mt-24 {\r\n  margin-top: 24px;\r\n}\r\n\r\n.ml-10 {\r\n  margin-left: 10px;\r\n}\r\n</style> "]}]}