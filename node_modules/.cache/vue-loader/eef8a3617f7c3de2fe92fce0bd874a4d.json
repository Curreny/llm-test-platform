{"remainingRequest":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\QuestionPreview.vue?vue&type=script&lang=js","dependencies":[{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\src\\views\\QuestionPreview.vue","mtime":1743152240771},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\babel-loader\\lib\\index.js","mtime":456789000000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\10989\\Desktop\\fwwb_project\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["QuestionPreview.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA+MA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA","file":"QuestionPreview.vue","sourceRoot":"src/views","sourcesContent":["<template>\r\n  <div class=\"question-preview-container\">\r\n    <!-- 页头 -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"back-link\">\r\n          <router-link to=\"/cover\">\r\n            <a-icon type=\"arrow-left\" /> 返回首页\r\n          </router-link>\r\n        </div>\r\n        <h1 class=\"header-title\">题库预览</h1>\r\n        <p class=\"header-desc\">查看完整题库内容与分析报告</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 主内容区 -->\r\n    <div class=\"content-section\">\r\n      <div class=\"content-wrapper\">\r\n        <!-- 筛选器 -->\r\n        <a-card class=\"filter-card\" :bordered=\"false\">\r\n          <a-row :gutter=\"16\">\r\n            <a-col :span=\"6\">\r\n              <a-form-item label=\"题目类型\">\r\n                <a-select v-model=\"filters.type\" placeholder=\"选择题目类型\" allowClear>\r\n                  <a-select-option value=\"multiple_choice\">选择题</a-select-option>\r\n                  <a-select-option value=\"true_false\">判断题</a-select-option>\r\n                  <a-select-option value=\"short_answer\">简答题</a-select-option>\r\n                  <a-select-option value=\"fill_blank\">填空题</a-select-option>\r\n                  <a-select-option value=\"code_completion\">代码补全</a-select-option>\r\n                  <a-select-option value=\"scenario\">情景分析</a-select-option>\r\n                </a-select>\r\n              </a-form-item>\r\n            </a-col>\r\n            <a-col :span=\"6\">\r\n              <a-form-item label=\"难度级别\">\r\n                <a-select v-model=\"filters.difficulty\" placeholder=\"选择难度级别\" allowClear>\r\n                  <a-select-option value=\"1\">初级</a-select-option>\r\n                  <a-select-option value=\"2\">中级</a-select-option>\r\n                  <a-select-option value=\"3\">高级</a-select-option>\r\n                  <a-select-option value=\"4\">专家</a-select-option>\r\n                  <a-select-option value=\"5\">挑战</a-select-option>\r\n                </a-select>\r\n              </a-form-item>\r\n            </a-col>\r\n            <a-col :span=\"6\">\r\n              <a-form-item label=\"包含关键词\">\r\n                <a-input v-model=\"filters.keyword\" placeholder=\"搜索关键词\" allowClear />\r\n              </a-form-item>\r\n            </a-col>\r\n            <a-col :span=\"6\">\r\n              <a-form-item label=\"内容来源\">\r\n                <a-select v-model=\"filters.source\" placeholder=\"选择内容来源\" allowClear>\r\n                  <a-select-option value=\"database\">题库数据</a-select-option>\r\n                  <a-select-option value=\"crawler\">网络爬虫</a-select-option>\r\n                  <a-select-option value=\"ai_generate\">AI生成</a-select-option>\r\n                </a-select>\r\n              </a-form-item>\r\n            </a-col>\r\n          </a-row>\r\n          <div class=\"filter-actions\">\r\n            <a-button @click=\"resetFilters\">重置</a-button>\r\n            <a-button type=\"primary\" @click=\"applyFilters\" class=\"ml-10\">应用筛选</a-button>\r\n          </div>\r\n        </a-card>\r\n\r\n        <!-- 分析统计 -->\r\n        <a-card class=\"stats-card mt-24\" :bordered=\"false\">\r\n          <div class=\"card-header mb-15\">\r\n            <h2 class=\"font-bold\">题库分析</h2>\r\n            <div class=\"header-line\"></div>\r\n          </div>\r\n          \r\n          <a-row :gutter=\"24\">\r\n            <a-col :span=\"8\">\r\n              <div class=\"chart-container type-distribution\">\r\n                <h3>题型分布</h3>\r\n                <div class=\"chart-placeholder\">\r\n                  <p>饼图 - 显示各类题型的比例</p>\r\n                </div>\r\n              </div>\r\n            </a-col>\r\n            <a-col :span=\"8\">\r\n              <div class=\"chart-container difficulty-distribution\">\r\n                <h3>难度分布</h3>\r\n                <div class=\"chart-placeholder\">\r\n                  <p>条形图 - 显示各难度级别的题目数量</p>\r\n                </div>\r\n              </div>\r\n            </a-col>\r\n            <a-col :span=\"8\">\r\n              <div class=\"chart-container source-distribution\">\r\n                <h3>来源分布</h3>\r\n                <div class=\"chart-placeholder\">\r\n                  <p>饼图 - 显示各来源的题目比例</p>\r\n                </div>\r\n              </div>\r\n            </a-col>\r\n          </a-row>\r\n        </a-card>\r\n\r\n        <!-- 题目列表 -->\r\n        <a-card class=\"questions-card mt-24\" :bordered=\"false\">\r\n          <div class=\"card-header mb-15\">\r\n            <h2 class=\"font-bold\">题目列表</h2>\r\n            <div class=\"header-line\"></div>\r\n          </div>\r\n          \r\n          <a-table \r\n            :columns=\"columns\" \r\n            :dataSource=\"questions\" \r\n            :pagination=\"pagination\"\r\n            :loading=\"loading\"\r\n            @change=\"handleTableChange\"\r\n            rowKey=\"id\"\r\n          >\r\n            <span slot=\"type\" slot-scope=\"text\">\r\n              {{ typeMap[text] || '未知类型' }}\r\n            </span>\r\n            \r\n            <span slot=\"difficulty\" slot-scope=\"text\">\r\n              <a-tag :color=\"getDifficultyColor(text)\">\r\n                {{ getDifficultyLabel(text) }}\r\n              </a-tag>\r\n            </span>\r\n            \r\n            <span slot=\"content\" slot-scope=\"text\">\r\n              {{ text.length > 50 ? text.substring(0, 50) + '...' : text }}\r\n            </span>\r\n            \r\n            <span slot=\"action\" slot-scope=\"text, record\">\r\n              <a @click=\"viewQuestion(record)\">查看</a>\r\n              <a-divider type=\"vertical\" />\r\n              <a @click=\"editQuestion(record)\">编辑</a>\r\n            </span>\r\n          </a-table>\r\n        </a-card>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 题目详情弹窗 -->\r\n    <a-modal\r\n      :visible=\"questionModalVisible\"\r\n      :title=\"currentQuestion.title || '题目详情'\"\r\n      @cancel=\"questionModalVisible = false\"\r\n      :footer=\"null\"\r\n      width=\"700px\"\r\n    >\r\n      <div class=\"question-detail\">\r\n        <div class=\"question-header\">\r\n          <a-tag :color=\"getDifficultyColor(currentQuestion.difficulty)\">\r\n            {{ getDifficultyLabel(currentQuestion.difficulty) }}\r\n          </a-tag>\r\n          <a-tag>{{ typeMap[currentQuestion.type] || '未知类型' }}</a-tag>\r\n          <a-tag color=\"blue\">{{ sourceMap[currentQuestion.source] || '未知来源' }}</a-tag>\r\n        </div>\r\n        \r\n        <div class=\"question-body mt-15\">\r\n          <div v-if=\"currentQuestion.type === 'multiple_choice'\">\r\n            <p class=\"question-content\">{{ currentQuestion.content }}</p>\r\n            <div class=\"question-options mt-15\">\r\n              <div v-for=\"(option, index) in currentQuestion.options\" :key=\"index\" \r\n                :class=\"['option-item', option.key === currentQuestion.answer ? 'option-correct' : '']\">\r\n                <span class=\"option-key\">{{ option.key }}.</span>\r\n                <span class=\"option-text\">{{ option.content }}</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"question-answer mt-15\">\r\n              <p><strong>正确答案：</strong>{{ currentQuestion.answer }}</p>\r\n            </div>\r\n          </div>\r\n          \r\n          <div v-else-if=\"currentQuestion.type === 'true_false'\">\r\n            <p class=\"question-content\">{{ currentQuestion.content }}</p>\r\n            <div class=\"question-answer mt-15\">\r\n              <p><strong>正确答案：</strong>{{ currentQuestion.answer ? '正确' : '错误' }}</p>\r\n            </div>\r\n          </div>\r\n          \r\n          <div v-else>\r\n            <p class=\"question-content\">{{ currentQuestion.content }}</p>\r\n            <div class=\"question-answer mt-15\" v-if=\"currentQuestion.answer\">\r\n              <p><strong>参考答案：</strong></p>\r\n              <div class=\"answer-content\">{{ currentQuestion.answer }}</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <a-divider />\r\n        \r\n        <div class=\"question-meta\">\r\n          <p v-if=\"currentQuestion.keywords && currentQuestion.keywords.length\">\r\n            <strong>关键词：</strong>\r\n            <a-tag v-for=\"(keyword, index) in currentQuestion.keywords\" :key=\"index\" color=\"blue\">\r\n              {{ keyword }}\r\n            </a-tag>\r\n          </p>\r\n          <p v-if=\"currentQuestion.source_url\">\r\n            <strong>来源链接：</strong>\r\n            <a :href=\"currentQuestion.source_url\" target=\"_blank\">{{ currentQuestion.source_url }}</a>\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </a-modal>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      loading: true,\r\n      filters: {\r\n        type: undefined,\r\n        difficulty: undefined,\r\n        keyword: '',\r\n        source: undefined\r\n      },\r\n      typeMap: {\r\n        'multiple_choice': '选择题',\r\n        'true_false': '判断题',\r\n        'short_answer': '简答题',\r\n        'fill_blank': '填空题',\r\n        'code_completion': '代码补全',\r\n        'scenario': '情景分析'\r\n      },\r\n      sourceMap: {\r\n        'database': '题库数据',\r\n        'crawler': '网络爬虫',\r\n        'ai_generate': 'AI生成'\r\n      },\r\n      columns: [\r\n        {\r\n          title: '序号',\r\n          dataIndex: 'id',\r\n          key: 'id',\r\n          width: 80\r\n        },\r\n        {\r\n          title: '题型',\r\n          dataIndex: 'type',\r\n          key: 'type',\r\n          width: 100,\r\n          scopedSlots: { customRender: 'type' }\r\n        },\r\n        {\r\n          title: '难度',\r\n          dataIndex: 'difficulty',\r\n          key: 'difficulty',\r\n          width: 100,\r\n          scopedSlots: { customRender: 'difficulty' }\r\n        },\r\n        {\r\n          title: '内容',\r\n          dataIndex: 'content',\r\n          key: 'content',\r\n          scopedSlots: { customRender: 'content' }\r\n        },\r\n        {\r\n          title: '来源',\r\n          dataIndex: 'source',\r\n          key: 'source',\r\n          width: 100,\r\n          render: (text) => this.sourceMap[text] || '未知'\r\n        },\r\n        {\r\n          title: '操作',\r\n          key: 'action',\r\n          width: 120,\r\n          scopedSlots: { customRender: 'action' }\r\n        }\r\n      ],\r\n      questions: [],\r\n      pagination: {\r\n        current: 1,\r\n        pageSize: 10,\r\n        total: 0\r\n      },\r\n      questionModalVisible: false,\r\n      currentQuestion: {}\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchQuestions();\r\n  },\r\n  methods: {\r\n    // 重置筛选条件\r\n    resetFilters() {\r\n      this.filters = {\r\n        type: undefined,\r\n        difficulty: undefined,\r\n        keyword: '',\r\n        source: undefined\r\n      };\r\n    },\r\n    \r\n    // 应用筛选条件\r\n    applyFilters() {\r\n      this.pagination.current = 1;\r\n      this.fetchQuestions();\r\n    },\r\n    \r\n    // 获取题目列表\r\n    fetchQuestions() {\r\n      this.loading = true;\r\n      \r\n      // 构建请求参数\r\n      const params = {\r\n        ...this.filters,\r\n        page: this.pagination.current,\r\n        pageSize: this.pagination.pageSize\r\n      };\r\n      \r\n      // 调用API获取题目列表\r\n      this.$axios.get('/api/questions', { params })\r\n        .then(response => {\r\n          const { questions, total } = response.data;\r\n          this.questions = questions;\r\n          this.pagination.total = total;\r\n        })\r\n        .catch(error => {\r\n          console.error('获取题目失败', error);\r\n          this.$message.error('获取题目列表失败');\r\n        })\r\n        .finally(() => {\r\n          this.loading = false;\r\n        });\r\n    },\r\n    \r\n    // 处理表格分页、排序、筛选变化\r\n    handleTableChange(pagination) {\r\n      this.pagination.current = pagination.current;\r\n      this.fetchQuestions();\r\n    },\r\n    \r\n    // 获取难度标签\r\n    getDifficultyLabel(difficulty) {\r\n      const difficultyMap = {\r\n        1: '初级',\r\n        2: '中级',\r\n        3: '高级',\r\n        4: '专家',\r\n        5: '挑战'\r\n      };\r\n      return difficultyMap[difficulty] || '未知';\r\n    },\r\n    \r\n    // 获取难度对应的颜色\r\n    getDifficultyColor(difficulty) {\r\n      const colorMap = {\r\n        1: 'green',\r\n        2: 'cyan',\r\n        3: 'blue',\r\n        4: 'purple',\r\n        5: 'red'\r\n      };\r\n      return colorMap[difficulty] || 'default';\r\n    },\r\n    \r\n    // 查看题目详情\r\n    viewQuestion(record) {\r\n      this.currentQuestion = { ...record };\r\n      this.questionModalVisible = true;\r\n    },\r\n    \r\n    // 编辑题目\r\n    editQuestion(record) {\r\n      // 跳转到编辑页面或打开编辑弹窗\r\n      this.$message.info('编辑功能开发中...');\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.question-preview-container {\r\n  min-height: 100vh;\r\n  background: #f5f5f5;\r\n}\r\n\r\n.page-header {\r\n  background: linear-gradient(135deg, rgba(69, 39, 160, 0.8), rgba(33, 150, 243, 0.8));\r\n  padding: 3rem 2rem;\r\n  color: #fff;\r\n  \r\n  .header-content {\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n  }\r\n  \r\n  .back-link {\r\n    margin-bottom: 1rem;\r\n    \r\n    a {\r\n      color: #fff;\r\n      display: inline-flex;\r\n      align-items: center;\r\n      font-size: 1rem;\r\n      \r\n      &:hover {\r\n        text-decoration: underline;\r\n      }\r\n      \r\n      .anticon {\r\n        margin-right: 0.5rem;\r\n      }\r\n    }\r\n  }\r\n  \r\n  .header-title {\r\n    font-size: 2rem;\r\n    font-weight: 600;\r\n    margin-bottom: 1rem;\r\n  }\r\n  \r\n  .header-desc {\r\n    font-size: 1.1rem;\r\n    opacity: 0.9;\r\n    max-width: 700px;\r\n  }\r\n}\r\n\r\n.content-section {\r\n  padding: 2rem;\r\n  \r\n  .content-wrapper {\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n  }\r\n}\r\n\r\n.filter-card, .stats-card, .questions-card {\r\n  background: #fff;\r\n  border-radius: 8px;\r\n  padding: 1.5rem;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.filter-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  margin-top: 1rem;\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  border-bottom: 1px solid #f0f0f0;\r\n  padding-bottom: 1rem;\r\n  \r\n  h2 {\r\n    margin: 0;\r\n    font-size: 1.25rem;\r\n  }\r\n  \r\n  .header-line {\r\n    height: 2px;\r\n    background: linear-gradient(to right, #4527a0, #2196f3);\r\n    width: 60px;\r\n  }\r\n}\r\n\r\n.chart-container {\r\n  background: #f9f9f9;\r\n  border-radius: 8px;\r\n  padding: 1rem;\r\n  height: 300px;\r\n  \r\n  h3 {\r\n    margin-top: 0;\r\n    margin-bottom: 1rem;\r\n    font-size: 1rem;\r\n  }\r\n  \r\n  .chart-placeholder {\r\n    height: 240px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    border: 1px dashed #ccc;\r\n    border-radius: 4px;\r\n    color: #999;\r\n  }\r\n}\r\n\r\n.question-detail {\r\n  .question-header {\r\n    margin-bottom: 1rem;\r\n  }\r\n  \r\n  .question-content {\r\n    font-size: 1.1rem;\r\n    line-height: 1.6;\r\n  }\r\n  \r\n  .question-options {\r\n    .option-item {\r\n      padding: 0.5rem;\r\n      margin-bottom: 0.5rem;\r\n      border-radius: 4px;\r\n      display: flex;\r\n      \r\n      &.option-correct {\r\n        background-color: rgba(82, 196, 26, 0.1);\r\n        border-left: 3px solid #52c41a;\r\n      }\r\n      \r\n      .option-key {\r\n        font-weight: bold;\r\n        margin-right: 0.5rem;\r\n        min-width: 20px;\r\n      }\r\n    }\r\n  }\r\n  \r\n  .question-answer {\r\n    background: #f5f5f5;\r\n    padding: 1rem;\r\n    border-radius: 4px;\r\n    \r\n    .answer-content {\r\n      white-space: pre-wrap;\r\n      line-height: 1.6;\r\n    }\r\n  }\r\n}\r\n\r\n.mt-10 {\r\n  margin-top: 10px;\r\n}\r\n\r\n.mt-15 {\r\n  margin-top: 15px;\r\n}\r\n\r\n.mt-24 {\r\n  margin-top: 24px;\r\n}\r\n\r\n.ml-10 {\r\n  margin-left: 10px;\r\n}\r\n</style> "]}]}